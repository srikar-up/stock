# ================================================================
# 🔒 Git Ignore Configuration for Stock Email Bot
# Prevents sensitive credentials, virtual environments, and caches
# from being committed or pushed to Git repositories.
# ================================================================

# 1. 🔑 Secrets, Passwords & Environment Variables (NEVER COMMIT!)
.env
.env.*
!.env.example
*.pem
*.key
*serviceAccount*.json
*firebase*.json
*credential*.json

# 2. 🐍 Virtual Environments
stocks/
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. ⚡ Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 4. 🧪 Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# 5. 💻 IDE & Editor Artifacts
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject

# 6. 🗂️ Operating System Temp Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 7. 📝 Logs & Temporary Output Files
*.log
*.tmp
temp/
tmp/
